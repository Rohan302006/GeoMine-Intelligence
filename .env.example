# =================================================================
# SIH26023 - Environment Configuration
# =================================================================

# Server
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration (PostgreSQL primary; auto-falls back to local SQLite if unconfigured)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sih26023
# DATABASE_URL=sqlite:///./coal_intelligence.db

# Security & JWT
JWT_SECRET=change_me_generate_a_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Configuration (Optional: system seamlessly runs with deterministic local fallback)
OPENAI_API_KEY=
GEMINI_API_KEY=
DEFAULT_AI_PROVIDER=local_fallback

# Storage & Uploads
UPLOAD_DIR=./data/raw
PROCESSED_DIR=./data/processed
REPORTS_DIR=./data/generated_reports
MAX_UPLOAD_SIZE_MB=50
