# =================================================================
# SIH26023 — Root .gitignore Configuration
# Comprehensive ignore rules for Full-Stack Next.js + FastAPI application
# =================================================================

# -----------------------------------------------------------------
# 1. Dependencies & Package Managers
# -----------------------------------------------------------------
node_modules/
*/node_modules/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# -----------------------------------------------------------------
# 2. Next.js & Frontend Build Outputs
# -----------------------------------------------------------------
.next/
*/.next/
out/
*/out/
build/
*/build/
dist/
*/dist/
.vercel/

# TypeScript artifacts
*.tsbuildinfo
next-env.d.ts

# -----------------------------------------------------------------
# 3. Python Bytecode & Runtime
# -----------------------------------------------------------------
__pycache__/
*/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
develop-eggs/
downloads/
eggs/
# Python packaging & build libraries (exempt frontend/lib)
/lib/
/lib64/
backend/lib/
!frontend/lib/
!frontend/lib/**
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# -----------------------------------------------------------------
# 4. Virtual Environments
# -----------------------------------------------------------------
.venv/
*/.venv/
venv/
*/venv/
ENV/
env/
*/env/
env.bak/
venv.bak/

# -----------------------------------------------------------------
# 5. Testing & Code Quality
# -----------------------------------------------------------------
.pytest_cache/
*/.pytest_cache/
.coverage
.coverage.*
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
htmlcov/
.tox/

# -----------------------------------------------------------------
# 6. Environment Variables, Secrets & Keys
# -----------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!*.env.example
!.env.example
*.pem
*.key
*.cert
*.crt

# -----------------------------------------------------------------
# 7. Database Runtime & Lock Files
# -----------------------------------------------------------------
*.db-journal
*.db-wal
*.db-shm
*.sqlite3-journal
# Note: coal_intelligence.db is seeded via: python backend/scripts/seed_database.py
# If you wish to exclude local SQLite databases entirely, uncomment the line below:
# *.db

# -----------------------------------------------------------------
# 8. Generated Reports & Transient Runtime Outputs
# -----------------------------------------------------------------
backend/data/generated_reports/*.pdf
backend/data/generated_reports/*.docx
backend/data/generated_reports/*.xlsx
!backend/data/generated_reports/.gitkeep
!backend/data/raw/.gitkeep
!backend/data/processed/.gitkeep
!backend/data/demo/.gitkeep

# -----------------------------------------------------------------
# 9. Logs & Debugging
# -----------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# -----------------------------------------------------------------
# 10. Operating System & IDE Specific Files
# -----------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Visual Studio Code & JetBrains IDE
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
